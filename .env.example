# Copiar a .env (NO subir .env al repositorio). Sin secretos reales.
POSTGRES_USER=novarent
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=novarent
DATABASE_URL=postgresql://novarent:cambia_esta_clave@db:5432/novarent
TEST_DATABASE_URL=postgresql://novarent:cambia_esta_clave@db:5432/novarent_test
# Precio de mercado por litro de combustible (MXN) usado en el cargo por combustible faltante
PRECIO_LITRO=24.50
DATA_DIR=data
# PIN de Administración para cancelar cargos extra (US08). Sin valor, nadie puede cancelar cargos.
PIN_ADMINISTRACION=cambia_este_pin
