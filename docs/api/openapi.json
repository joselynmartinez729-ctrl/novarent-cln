  "components": {
    "schemas": {
      "CancelacionCargoIn": {
        "properties": {
          "rol": {
            "type": "string",
            "enum": [
              "AGENTE",
              "PATIO",
              "LIMPIEZA",
              "ADMINISTRACION"
            ],
            "title": "Rol"
          },
          "pin": {
            "type": "string",
            "title": "Pin"
          },
          "motivo": {
            "type": "string",
            "minLength": 3,
            "title": "Motivo"
          }
        },
        "type": "object",
        "required": [
          "rol",
          "pin",
          "motivo"
        ],
        "title": "CancelacionCargoIn"
      },
      "CargoPorDanosIn": {
        "properties": {
          "monto_mxn": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Monto Mxn"
          },
          "descripcion": {
            "type": "string",
            "title": "Descripcion",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "monto_mxn"
        ],
        "title": "CargoPorDanosIn"
      },
      "DecisionIn": {
        "properties": {
          "acepta_upgrade": {
            "type": "boolean",
            "title": "Acepta Upgrade",
            "default": true
          },
          "acepta_inferior": {
            "type": "boolean",
            "title": "Acepta Inferior",
            "default": true
          }
        },
        "type": "object",
        "title": "DecisionIn"
      },
      "DevolucionIn": {
        "properties": {
          "hora_devolucion": {
            "type": "string",
            "format": "date-time",
            "title": "Hora Devolucion"
          },
          "inspeccion_devolucion": {
            "$ref": "#/components/schemas/InspeccionIn"
          }
        },
        "type": "object",
        "required": [
          "hora_devolucion",
          "inspeccion_devolucion"
        ],
        "title": "DevolucionIn"
      },
      "DocumentacionIn": {
        "properties": {
          "titular": {
            "type": "string",
            "title": "Titular"
          },
          "fecha_nacimiento": {
            "type": "string",
            "format": "date",
            "title": "Fecha Nacimiento"
          },
          "licencia_vigente_hasta": {
            "type": "string",
            "format": "date",
            "title": "Licencia Vigente Hasta"
          },
          "identificacion_vigente_hasta": {
            "type": "string",
            "format": "date",
            "title": "Identificacion Vigente Hasta"
          }
        },
        "type": "object",
        "required": [
          "titular",
          "fecha_nacimiento",
          "licencia_vigente_hasta",
          "identificacion_vigente_hasta"
        ],
        "title": "DocumentacionIn"
      },
      "EntregaIn": {
        "properties": {
          "ultimos_4": {
            "type": "string",
            "maxLength": 4,
            "minLength": 4,
            "pattern": "^\\d{4}$",
            "title": "Ultimos 4"
          },
          "titular": {
            "type": "string",
            "title": "Titular"
          },
          "inspeccion_salida": {
            "$ref": "#/components/schemas/InspeccionIn"
          }
        },
        "type": "object",
        "required": [
          "ultimos_4",
          "titular",
          "inspeccion_salida"
        ],
        "title": "EntregaIn"
      },
      "ExtensionIn": {
        "properties": {
          "nuevo_fin": {
            "type": "string",
            "format": "date-time",
            "title": "Nuevo Fin"
          },
          "vehiculo_reservado_por_otro": {
            "type": "boolean",
            "title": "Vehiculo Reservado Por Otro",
            "description": "El agente verifica si otro cliente tiene reservado el vehículo (S-15)",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "nuevo_fin"
        ],
        "title": "ExtensionIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspeccionIn": {
        "properties": {
          "esquema_completado": {
            "type": "boolean",
            "title": "Esquema Completado"
          },
          "fotos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fotos",
            "description": "URLs o nombres de fotografías"
          },
          "kilometraje": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Kilometraje"
          },
          "combustible": {
            "type": "string",
            "enum": [
              "vacio",
              "1/4",
              "1/2",
              "3/4",
              "lleno"
            ],
            "title": "Combustible"
          },
          "danos": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Danos",
            "description": "Zonas marcadas en el esquema digital"
          }
        },
        "type": "object",
        "required": [
          "esquema_completado",
          "kilometraje",
          "combustible"
        ],
        "title": "InspeccionIn"
      },
      "MantenimientoMayorIn": {
        "properties": {
